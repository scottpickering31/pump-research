# Local development only. Copy this file to .env and adjust as needed.
PUMP_RESEARCH_ENVIRONMENT=development
PUMP_RESEARCH_DATABASE_URL=postgresql+asyncpg://pump_research:pump_research@localhost:5433/pump_research
PUMP_RESEARCH_DATABASE_CONNECT_TIMEOUT_SECONDS=5
PUMP_RESEARCH_LOG_LEVEL=INFO
PUMP_RESEARCH_LOG_JSON=false
PUMP_RESEARCH_DEX_SCREENER_BASE_URL=https://api.dexscreener.com
# The official /tokens/v1 endpoint limit is 300 requests/minute; use 20% headroom.
PUMP_RESEARCH_DEX_SCREENER_REQUESTS_PER_MINUTE=240
PUMP_RESEARCH_DEX_SCREENER_TIMEOUT_SECONDS=10
PUMP_RESEARCH_DEX_SCREENER_MAX_ATTEMPTS=3
PUMP_RESEARCH_DEX_SCREENER_RETRY_BACKOFF_SECONDS=0.5
# Pump.fun discovery adapter. Obtain an authorized token through Pump.fun; do not commit it.
PUMP_RESEARCH_PUMP_FUN_BASE_URL=https://frontend-api-v3.pump.fun
PUMP_RESEARCH_PUMP_FUN_API_TOKEN=
PUMP_RESEARCH_PUMP_FUN_TIMEOUT_SECONDS=10
# Durable initial DEX-availability admission. Values are recorded in lifecycle evidence.
PUMP_RESEARCH_DEX_AVAILABILITY_RETRY_SECONDS=60
PUMP_RESEARCH_DEX_AVAILABILITY_LEASE_SECONDS=120
