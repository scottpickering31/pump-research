# Local development only. Copy this file to .env and adjust as needed.
PUMP_RESEARCH_ENVIRONMENT=development
PUMP_RESEARCH_DATABASE_URL=postgresql+asyncpg://pump_research:pump_research@localhost:5433/pump_research
PUMP_RESEARCH_DATABASE_CONNECT_TIMEOUT_SECONDS=5
PUMP_RESEARCH_LOG_LEVEL=INFO
PUMP_RESEARCH_LOG_JSON=false
PUMP_RESEARCH_DEX_SCREENER_BASE_URL=https://api.dexscreener.com
# The official /tokens/v1 endpoint limit is 300 requests/minute; use 20% headroom.
PUMP_RESEARCH_DEX_SCREENER_REQUESTS_PER_MINUTE=240
PUMP_RESEARCH_DEX_SCREENER_TIMEOUT_SECONDS=10
PUMP_RESEARCH_DEX_SCREENER_MAX_ATTEMPTS=3
PUMP_RESEARCH_DEX_SCREENER_RETRY_BACKOFF_SECONDS=0.5
# Pump.fun discovery adapter. Obtain an authorized token through Pump.fun; do not commit it.
PUMP_RESEARCH_PUMP_FUN_BASE_URL=https://frontend-api-v3.pump.fun
PUMP_RESEARCH_PUMP_FUN_API_TOKEN=
PUMP_RESEARCH_PUMP_FUN_TIMEOUT_SECONDS=10
# Durable initial DEX-availability admission. Values are recorded in lifecycle evidence.
PUMP_RESEARCH_DEX_AVAILABILITY_RETRY_SECONDS=60
PUMP_RESEARCH_DEX_AVAILABILITY_LEASE_SECONDS=120
# Adaptive market polling. These exact values are persisted with scheduler evidence.
PUMP_RESEARCH_SCHEDULER_NEW_INTERVAL_SECONDS=5
PUMP_RESEARCH_SCHEDULER_ACTIVE_INTERVAL_SECONDS=5
PUMP_RESEARCH_SCHEDULER_WATCH_INTERVAL_SECONDS=15
PUMP_RESEARCH_SCHEDULER_FADING_INTERVAL_SECONDS=60
PUMP_RESEARCH_SCHEDULER_DORMANT_INTERVAL_SECONDS=900
PUMP_RESEARCH_SCHEDULER_RESURRECTED_INTERVAL_SECONDS=5
PUMP_RESEARCH_SCHEDULER_BATCH_SIZE=30
PUMP_RESEARCH_SCHEDULER_LEASE_SECONDS=120
PUMP_RESEARCH_SCHEDULER_MAX_IN_FLIGHT_BATCHES=4
# Lifecycle classification. These values are persisted with every transition;
# calibrate them only after analysing collected data, never by editing code.
PUMP_RESEARCH_LIFECYCLE_NEW_TO_ACTIVE_MIN_VOLUME_M5_USD=100
PUMP_RESEARCH_LIFECYCLE_NEW_TO_WATCH_MIN_LIQUIDITY_USD=1000
PUMP_RESEARCH_LIFECYCLE_ACTIVE_TO_FADING_MAX_VOLUME_M5_USD=25
PUMP_RESEARCH_LIFECYCLE_WATCH_TO_FADING_MAX_VOLUME_M5_USD=10
PUMP_RESEARCH_LIFECYCLE_FADING_TO_DORMANT_MAX_VOLUME_H1_USD=10
PUMP_RESEARCH_LIFECYCLE_FADING_TO_DORMANT_MAX_LIQUIDITY_USD=100
PUMP_RESEARCH_LIFECYCLE_DORMANT_TO_RESURRECTED_MIN_VOLUME_M5_USD=100
PUMP_RESEARCH_LIFECYCLE_DORMANT_TO_RESURRECTED_MIN_LIQUIDITY_USD=500
