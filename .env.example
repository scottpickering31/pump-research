# Local development only. Copy this file to .env and adjust as needed.
PUMP_RESEARCH_ENVIRONMENT=development
PUMP_RESEARCH_DATABASE_URL=postgresql+asyncpg://pump_research:pump_research@localhost:5433/pump_research
PUMP_RESEARCH_DATABASE_CONNECT_TIMEOUT_SECONDS=5
PUMP_RESEARCH_LOG_LEVEL=INFO
PUMP_RESEARCH_LOG_JSON=false
PUMP_RESEARCH_DEX_SCREENER_BASE_URL=https://api.dexscreener.com
# Application request ceiling. The scheduler applies its own configurable safety
# headroom below this value; the shared HTTP limiter still enforces this ceiling.
PUMP_RESEARCH_DEX_SCREENER_REQUESTS_PER_MINUTE=240
PUMP_RESEARCH_DEX_SCREENER_TIMEOUT_SECONDS=10
PUMP_RESEARCH_DEX_SCREENER_MAX_ATTEMPTS=3
PUMP_RESEARCH_DEX_SCREENER_RETRY_BACKOFF_SECONDS=0.5
# Shared bounded promotion feeds: 1.2 requests/minute at these defaults.
PUMP_RESEARCH_DEX_SCREENER_BOOST_ROUTE_REQUESTS_PER_MINUTE=60
PUMP_RESEARCH_BOOST_LATEST_POLL_SECONDS=60
PUMP_RESEARCH_BOOST_TOP_POLL_SECONDS=300
# Read-only mint-account facts. URLs may contain provider credentials and are
# excluded from durable configuration snapshots/logs.
PUMP_RESEARCH_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PUMP_RESEARCH_SOLANA_RPC_TIMEOUT_SECONDS=15
PUMP_RESEARCH_SOLANA_RPC_REQUESTS_PER_MINUTE=2
PUMP_RESEARCH_TOKEN_SECURITY_POLL_SECONDS=30
PUMP_RESEARCH_TOKEN_SECURITY_LEASE_SECONDS=180
# Candidate-only Phase 6 enrichment. Indexed providers are disabled until an
# operator supplies and accepts a provider-specific adapter/contract.
PUMP_RESEARCH_SECURITY_ENRICHMENT_POLL_SECONDS=1
PUMP_RESEARCH_SECURITY_ENRICHMENT_WORKERS=4
PUMP_RESEARCH_SECURITY_INDEXER_REQUESTS_PER_MINUTE=6
PUMP_RESEARCH_SECURITY_TRANSACTION_HISTORY_REQUESTS_PER_MINUTE=4
PUMP_RESEARCH_SECURITY_HOLDER_REQUESTS_PER_MINUTE=1
PUMP_RESEARCH_SECURITY_WALLET_GRAPH_REQUESTS_PER_MINUTE=1
# PUMP_RESEARCH_SECURITY_INDEXER_URL=https://provider.example/v1
# PUMP_RESEARCH_SECURITY_INDEXER_API_KEY=replace-with-provider-secret
# Shared as-of context is derived locally once per closed UTC bucket.
PUMP_RESEARCH_MARKET_CONTEXT_INTERVAL_SECONDS=300
# PumpPortal live discovery. Obtain an API key outside this application from
# https://pumpportal.fun/trading-api/setup/ and never commit it.
PUMP_RESEARCH_PUMPPORTAL_WEBSOCKET_URL=wss://pumpportal.fun/api/data
# PUMP_RESEARCH_PUMPPORTAL_API_KEY=replace-with-your-private-api-key
PUMP_RESEARCH_PUMPPORTAL_CONNECT_TIMEOUT_SECONDS=10
PUMP_RESEARCH_PUMPPORTAL_FETCH_WAIT_SECONDS=1
PUMP_RESEARCH_PUMPPORTAL_BATCH_SIZE=500
PUMP_RESEARCH_PUMPPORTAL_QUEUE_CAPACITY=10000
PUMP_RESEARCH_PUMPPORTAL_RECONNECT_INITIAL_SECONDS=1
PUMP_RESEARCH_PUMPPORTAL_RECONNECT_MAX_SECONDS=30
PUMP_RESEARCH_PUMPPORTAL_RECONNECT_JITTER_RATIO=0.2
# Fixed-task collector loops; these are process controls, not per-token queues.
PUMP_RESEARCH_COLLECTOR_DISCOVERY_POLL_SECONDS=2
PUMP_RESEARCH_COLLECTOR_RECONCILIATION_POLL_SECONDS=1
PUMP_RESEARCH_COLLECTOR_SCHEDULER_POLL_SECONDS=0.25
PUMP_RESEARCH_COLLECTOR_HEARTBEAT_SECONDS=10
PUMP_RESEARCH_COLLECTOR_SHUTDOWN_GRACE_SECONDS=30
# Exact database bytes plus compact per-relation estimates, sampled every 10 minutes.
PUMP_RESEARCH_STORAGE_TELEMETRY_INTERVAL_SECONDS=600
# Durable initial DEX-availability admission. Values are recorded in lifecycle evidence.
PUMP_RESEARCH_DEX_AVAILABILITY_RETRY_SECONDS=60
PUMP_RESEARCH_DEX_AVAILABILITY_LEASE_SECONDS=120
# Adaptive market polling. These exact values are persisted with scheduler evidence.
PUMP_RESEARCH_SCHEDULER_NEW_INITIAL_INTERVAL_SECONDS=15
PUMP_RESEARCH_SCHEDULER_NEW_INITIAL_DURATION_SECONDS=120
PUMP_RESEARCH_SCHEDULER_NEW_INTERVAL_SECONDS=30
PUMP_RESEARCH_SCHEDULER_EARLY_UNTIL_SECONDS=600
PUMP_RESEARCH_SCHEDULER_MATURE_INTERVAL_SECONDS=300
PUMP_RESEARCH_SCHEDULER_MATURE_UNTIL_SECONDS=3600
PUMP_RESEARCH_SCHEDULER_COOLED_INTERVAL_SECONDS=1800
PUMP_RESEARCH_SCHEDULER_COOLED_UNTIL_SECONDS=21600
PUMP_RESEARCH_SCHEDULER_LONG_TAIL_DAY_INTERVAL_SECONDS=7200
PUMP_RESEARCH_SCHEDULER_LONG_TAIL_DAY_UNTIL_SECONDS=86400
PUMP_RESEARCH_SCHEDULER_LONG_TAIL_WEEK_INTERVAL_SECONDS=43200
PUMP_RESEARCH_SCHEDULER_RETIRE_AFTER_SECONDS=604800
PUMP_RESEARCH_SCHEDULER_ACTIVE_INTERVAL_SECONDS=5
PUMP_RESEARCH_SCHEDULER_WATCH_INTERVAL_SECONDS=15
PUMP_RESEARCH_SCHEDULER_FADING_INTERVAL_SECONDS=120
# FADING is finite: 120s for 30m, 1800s until 6h, then control rotation.
PUMP_RESEARCH_SCHEDULER_FADING_TAIL_FAST_DURATION_SECONDS=1800
PUMP_RESEARCH_SCHEDULER_FADING_TAIL_COOL_INTERVAL_SECONDS=1800
PUMP_RESEARCH_SCHEDULER_FADING_TAIL_TOTAL_DURATION_SECONDS=21600
PUMP_RESEARCH_SCHEDULER_DORMANT_INTERVAL_SECONDS=900
PUMP_RESEARCH_SCHEDULER_RESURRECTED_INTERVAL_SECONDS=5
PUMP_RESEARCH_SCHEDULER_CAPACITY_HEADROOM_RATIO=0.20
PUMP_RESEARCH_SCHEDULER_CAPACITY_REFRESH_SECONDS=30
# Preserve 14 safe requests/min for availability, retries, and future integrations.
PUMP_RESEARCH_SCHEDULER_RESERVED_REQUESTS_PER_MINUTE=14
# Hard aggregate retired-token sample ceiling, independent of retired population.
PUMP_RESEARCH_SCHEDULER_CONTROL_SCAN_TOKENS_PER_MINUTE=2
PUMP_RESEARCH_SCHEDULER_BATCH_SIZE=30
PUMP_RESEARCH_SCHEDULER_LEASE_SECONDS=120
PUMP_RESEARCH_SCHEDULER_MAX_IN_FLIGHT_BATCHES=4
# Archive reads are streamed in bounded chunks; export never deletes PostgreSQL rows.
PUMP_RESEARCH_ARCHIVE_EXPORT_CHUNK_ROWS=25000
PUMP_RESEARCH_ARCHIVE_MAX_FILE_ROWS=1000000
PUMP_RESEARCH_ARCHIVE_MINIMUM_FREE_BYTES=2147483648
PUMP_RESEARCH_ARCHIVE_MINIMUM_HOT_RETENTION_DAYS=14
# Optional S3-compatible independent archive storage. All six values are
# required by S3 archive commands. The endpoint must be HTTPS with no path,
# query, fragment, embedded credential, or bucket suffix. Never commit real keys.
# PUMP_RESEARCH_ARCHIVE_S3_ENDPOINT_URL=https://s3.region.provider.example
# PUMP_RESEARCH_ARCHIVE_S3_BUCKET=private-research-archive
# PUMP_RESEARCH_ARCHIVE_S3_PREFIX=pump-research/archives/v2
# PUMP_RESEARCH_ARCHIVE_S3_ACCESS_KEY_ID=replace-with-restricted-key-id
# PUMP_RESEARCH_ARCHIVE_S3_SECRET_ACCESS_KEY=replace-with-restricted-secret-key
# PUMP_RESEARCH_ARCHIVE_S3_REGION=region-name
# Lifecycle classification. These values are persisted with every transition;
# calibrate them only after analysing collected data, never by editing code.
PUMP_RESEARCH_LIFECYCLE_NEW_TO_ACTIVE_MIN_VOLUME_M5_USD=100
PUMP_RESEARCH_LIFECYCLE_NEW_TO_WATCH_MIN_LIQUIDITY_USD=1000
PUMP_RESEARCH_LIFECYCLE_ACTIVE_TO_FADING_MAX_VOLUME_M5_USD=25
PUMP_RESEARCH_LIFECYCLE_WATCH_TO_FADING_MAX_VOLUME_M5_USD=10
PUMP_RESEARCH_LIFECYCLE_FADING_TO_DORMANT_MAX_VOLUME_H1_USD=10
PUMP_RESEARCH_LIFECYCLE_FADING_TO_DORMANT_MAX_LIQUIDITY_USD=100
PUMP_RESEARCH_LIFECYCLE_DORMANT_TO_RESURRECTED_MIN_VOLUME_M5_USD=100
PUMP_RESEARCH_LIFECYCLE_DORMANT_TO_RESURRECTED_MIN_LIQUIDITY_USD=500
